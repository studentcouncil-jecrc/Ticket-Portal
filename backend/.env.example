# Local development only. Do not commit a real .env file.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-admin-jwt-secret
APP_ADMIN_JWT_SECRET=replace-with-a-different-long-random-app-jwt-secret
VERIFIED_FROM_EMAIL=events@example.com
RESEND_API_KEY=re_xxxxxxxxx

# Comma-separated browser origins. This is required in production.
# Example: https://your-project.vercel.app,https://admin.example.com
CORS_ORIGINS=http://localhost:5173

# Required only when running `npm run seed:superadmin`.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=SDC@123456
